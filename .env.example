# Copy to .env and fill in real values. Never commit the real .env file.
# This file documents every environment variable the platform reads.

# --- General ---
NODE_ENV=development
PORT=4100

# --- Database (apps/api) ---
# Local dev matches docker-compose.yml's postgres service. Host port is 5433,
# not the default 5432, because this dev machine already runs a native
# Postgres on 5432 outside Docker — adjust if your setup differs.
DATABASE_URL=postgresql://cctv:cctv_dev_password@localhost:5433/cctv

# --- Redis / BullMQ (apps/api) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Sessions are DB-backed opaque tokens (revocable), not JWTs — see
# apps/api/src/lib/sessions.ts. This secret is reserved for future signed
# tokens (email verification, password reset), not session auth.
# Generate with: openssl rand -hex 32. Required to be >=32 chars; the default
# in apps/api/src/env.ts is dev-only and MUST be overridden for anything beyond
# a laptop demo.
APP_SECRET=

# How long a session stays valid without being revoked.
SESSION_TTL_DAYS=30

# --- Camera credential encryption (apps/api) ---
# AES-256-GCM key, exactly 32 raw bytes, hex-encoded (64 hex characters).
# No default on purpose — a camera credential "encrypted" with a shared
# default key is not actually protected. Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# --- Object storage: S3-compatible ---
# Local dev uses LocalStack's S3 service (docker-compose.yml), not MinIO —
# MinIO's container images are no longer pullable from Docker Hub without
# authentication as of this environment (see docs/architecture.md §7).
# Production targets real AWS S3; same code path, different endpoint/creds.
STORAGE_ENDPOINT=http://localhost:4566
STORAGE_REGION=us-east-1
STORAGE_BUCKET=cctv-recordings
# LocalStack's default S3 service accepts any access key/secret.
STORAGE_ACCESS_KEY_ID=test
STORAGE_SECRET_ACCESS_KEY=test
# true for LocalStack/MinIO (path-style), false for real AWS S3
# (virtual-hosted-style).
STORAGE_FORCE_PATH_STYLE=true

# Seconds a signed playback/download URL remains valid.
SIGNED_URL_TTL_SECONDS=300

# --- MediaMTX (apps/api) ---
# Config API (add/remove per-camera recording paths) and playback API
# (fetch completed segments). Both unauthenticated in local dev on purpose
# — see infra/mediamtx/mediamtx.yml and docs/security.md.
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_PLAYBACK_URL=http://localhost:9996
# HLS server used for Live View. Browsers never reach it directly — the API
# proxies it after checking the session and workspace.
MEDIAMTX_HLS_URL=http://localhost:8888
# Where MediaMTX writes recordings (path as seen by MediaMTX). Docker: keep
# /recordings. Native install: an absolute writable folder, e.g.
# /path/to/Universal-CCTV/.local-run/recordings (see docs/local-testing.md).
MEDIAMTX_RECORD_DIR=/recordings

# --- Camera network safety (SSRF guard) ---
# Block RFC1918 private ranges for camera hosts (recommended for a shared
# cloud deployment; leave false when cameras are on the server's LAN).
BLOCK_PRIVATE_CAMERA_HOSTS=false
# Extra hosts/IPs that must never be dialed, comma-separated.
CAMERA_HOST_DENYLIST=
# Fake "SIMULATED" test cameras. Defaults to true in development, false in production.
# ALLOW_SIMULATED_CAMERAS=true
# Behind a reverse proxy/load balancer set to the number of proxy hops (e.g. 1)
# so rate limits use the real client IP.
# TRUST_PROXY=1

# --- CORS / CSRF ---
# Exact web app origin(s), comma-separated. Also used by the Origin check
# that blocks cross-site state-changing requests.
CORS_ORIGIN=http://localhost:3100

# --- Motion detection (worker) ---
# The worker reads cameras through MediaMTX's RTSP server and runs ffmpeg.
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
FFMPEG_PATH=ffmpeg
MOTION_CHECK_INTERVAL_SECONDS=20
MOTION_SAMPLE_SECONDS=4
# Min minutes between two "Motion detected" alerts for the same camera.
MOTION_ALERT_COOLDOWN_MINUTES=5

# --- Invites / email ---
# Public URL of the web app (used in invite links).
APP_PUBLIC_URL=http://localhost:3100
INVITE_TTL_HOURS=72
# Optional SMTP, e.g. smtp://user:pass@smtp.example.com:587. If unset, the
# invite link is shown once to the inviter (and logged in development).
# SMTP_URL=
# MAIL_FROM=Universal CCTV <no-reply@example.com>

# --- Web app (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4100

# --- Postgres container credentials (docker-compose.yml) ---
# Must match the credentials embedded in DATABASE_URL above.
POSTGRES_USER=cctv
POSTGRES_PASSWORD=cctv_dev_password
POSTGRES_DB=cctv
