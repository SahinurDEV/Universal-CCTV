generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy, users, access control
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  /// Workspace-wide recording retention in days. Null = fall back to the
  /// retention policy captured on each segment at ingest time.
  retentionDays Int? @map("retention_days")
  /// Set by a platform admin. Members lose access; motion alerts pause.
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships      Membership[]
  locations        Location[]
  cameras          Camera[]
  retentionPolicies RetentionPolicy[]
  subscriptions    Subscription[]
  usageRecords     UsageRecord[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  gatewayDevices   GatewayDevice[]
  integrationConfigs IntegrationConfig[]
  recordingSegments RecordingSegment[]
  motionEvents     MotionEvent[]
  invites          Invite[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String?  @map("display_name")
  passwordHash String   @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Platform super-admin (operator of the whole service), completely
  /// separate from workspace roles. Only set by the CLI
  /// (`pnpm --filter @cctv/api admin:grant`) or PLATFORM_ADMIN_EMAILS —
  /// there is no API that writes it.
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships  Membership[]
  auditLogs    AuditLog[]
  sessions     Session[]
  invitesSent  Invite[]
  pushSubscriptions PushSubscription[]
  fcmTokens    FcmToken[]
  platformAuditLogs PlatformAuditLog[]

  @@map("users")
}

/// Opaque, DB-backed session tokens (not JWTs) so a session can actually be
/// revoked on logout/compromise, per the security requirement — a bare JWT
/// can't be invalidated server-side without a separate blocklist anyway, so
/// this is simpler, not more complex, for that requirement.
/// Only a SHA-256 hash of the token is stored; the raw token lives only in
/// the httpOnly cookie on the client and is never persisted or logged.
model Session {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  tokenHash       String    @unique @map("token_hash")
  /// Which tenant this session is currently acting as. Nullable because a
  /// freshly-registered user's first membership is set here immediately, but
  /// the field stays nullable to support a future "pick a tenant" step for
  /// users invited to zero tenants.
  activeTenantId  String?   @map("active_tenant_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  lastUsedAt      DateTime  @default(now()) @map("last_used_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  /// "web" (httpOnly cookie) or "mobile" (Authorization: Bearer).
  clientType      String    @default("web") @map("client_type")
  deviceName      String?   @map("device_name")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmTokens FcmToken[]

  @@index([userId])
  @@map("sessions")
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

/// Join table between User and Tenant. Role-based access control for MVP is a
/// single enum per membership rather than a separate fine-grained permissions
/// table — see docs/database-schema.md for the tradeoff.
model Membership {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      Role
  /// Per-user, per-workspace alert preferences: which notification types
  /// this member wants to see (in-app list + unread badge). Null = all on.
  /// Shape: { mutedTypes: NotificationType[] }
  notificationPreferences Json? @map("notification_preferences")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Locations and cameras
// ---------------------------------------------------------------------------

model Location {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  address   String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cameras Camera[]

  @@index([tenantId])
  @@map("locations")
}

enum ConnectorType {
  RTSP
  ONVIF
  SIMULATED
}

model Camera {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  locationId    String?       @map("location_id")
  name          String
  manufacturer  String?
  model         String?
  connectorType ConnectorType @map("connector_type")
  host          String
  port          Int
  onvifPort     Int?          @map("onvif_port")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location   Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  credential CameraCredential?
  capability CameraCapabilityRecord?
  sessions   CameraConnectionSession[]
  recordingJobs    RecordingJob[]
  recordingSegments RecordingSegment[]
  retentionPolicy  RetentionPolicy? @relation(fields: [retentionPolicyId], references: [id])
  retentionPolicyId String? @map("retention_policy_id")
  /// Motion detection (ffmpeg scene-change sampling in the worker).
  motionEnabled     Boolean  @default(false) @map("motion_enabled")
  /// 1 (least sensitive) .. 100 (most sensitive).
  motionSensitivity Int      @default(50) @map("motion_sensitivity")
  motionLastCheckedAt DateTime? @map("motion_last_checked_at")
  motionLastError   String?  @map("motion_last_error")
  motionEvents      MotionEvent[]
  /// Which detections raise an alert: "any" (all motion), "person", "vehicle".
  motionAlertClasses String[] @default(["any"]) @map("motion_alert_classes")
  /// Per-camera retention override in days (null = workspace setting).
  retentionDaysOverride Int? @map("retention_days_override")

  @@index([tenantId])
  @@index([locationId])
  @@map("cameras")
}

/// Camera secrets (RTSP URL embeds username/password) are kept in their own
/// table, separate from general camera metadata, and are never returned by any
/// endpoint that lists/reads camera records for display. `encryptedValue` is
/// AES-256-GCM ciphertext using a server-held key (CREDENTIAL_ENCRYPTION_KEY) —
/// see docs/security.md. A dedicated secrets manager (Vault/AWS Secrets Manager)
/// is the recommended production upgrade; documented as a tradeoff, not built
/// for MVP to avoid an unnecessary external dependency this early.
model CameraCredential {
  id              String   @id @default(uuid())
  cameraId        String   @unique @map("camera_id")
  encryptedValue  String   @map("encrypted_value")
  encryptionIv    String   @map("encryption_iv")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@map("camera_credentials")
}

enum SupportTier {
  FULLY_SUPPORTED
  PARTIALLY_SUPPORTED
  CONNECTED_MISSING_CAPABILITIES
  UNSUPPORTED
}

/// Written only by the capability-detection flow (CameraConnector.detectCapabilities).
/// Never hand-edited to mark a camera as more capable than it tested.
model CameraCapabilityRecord {
  id               String      @id @default(uuid())
  cameraId         String      @unique @map("camera_id")
  supportTier      SupportTier @map("support_tier")
  liveView         Boolean     @default(false)
  cloudRecording   Boolean     @default(false)
  playback         Boolean     @default(false)
  ptz              Boolean     @default(false)
  zoom             Boolean     @default(false)
  motionEvents     Boolean     @default(false) @map("motion_events")
  imageSettings    Boolean     @default(false) @map("image_settings")
  audio            Boolean     @default(false)
  firmwareUpdate   Boolean     @default(false) @map("firmware_update")
  detectedAt       DateTime    @default(now()) @map("detected_at")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@map("camera_capabilities")
}

enum ConnectionStatusValue {
  ONLINE
  OFFLINE
  DEGRADED
  UNKNOWN
}

/// History of connection attempts/status changes, used for health monitoring,
/// offline notifications, and debugging. Not the same as a recording job.
model CameraConnectionSession {
  id        String                @id @default(uuid())
  cameraId  String                @map("camera_id")
  status    ConnectionStatusValue
  errorMessage String?            @map("error_message")
  startedAt DateTime              @default(now()) @map("started_at")
  endedAt   DateTime?             @map("ended_at")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, startedAt])
  @@map("camera_connection_sessions")
}

// ---------------------------------------------------------------------------
// Recording pipeline
// ---------------------------------------------------------------------------

enum RecordingJobStatus {
  PENDING
  RUNNING
  STOPPED
  FAILED
}

/// At most one non-STOPPED/FAILED job per camera is enforced at the application
/// layer (transaction + unique partial index via raw SQL migration) to prevent
/// duplicate ffmpeg processes recording the same camera twice.
model RecordingJob {
  id            String             @id @default(uuid())
  cameraId      String             @map("camera_id")
  tenantId      String             @map("tenant_id")
  status        RecordingJobStatus @default(PENDING)
  /// Target segment length requested from MediaMTX when this job started.
  /// Actual segment durations vary slightly (fMP4 cuts on keyframe
  /// boundaries) — this is the target, not a guarantee; see
  /// docs/video-recording.md.
  segmentSeconds Int               @default(60) @map("segment_seconds")
  workerId      String?            @map("worker_id")
  startedAt     DateTime?          @map("started_at")
  stoppedAt     DateTime?          @map("stopped_at")
  lastError     String?            @map("last_error")
  createdAt     DateTime           @default(now()) @map("created_at")

  camera   Camera             @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  segments RecordingSegment[]

  @@index([cameraId, status])
  @@index([tenantId])
  @@map("recording_jobs")
}

enum SegmentStatus {
  RECORDING
  COMPLETE
  UPLOAD_FAILED
  EXPIRED
  DELETED
}

model RecordingSegment {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  cameraId    String        @map("camera_id")
  jobId       String        @map("job_id")
  startedAt   DateTime      @map("started_at")
  endedAt     DateTime?     @map("ended_at")
  durationSec Int?          @map("duration_sec")
  objectKey   String        @unique @map("object_key")
  fileSizeBytes BigInt?     @map("file_size_bytes")
  status      SegmentStatus @default(RECORDING)
  integrityVerifiedAt DateTime? @map("integrity_verified_at")
  retentionExpiresAt  DateTime? @map("retention_expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  camera Camera       @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  job    RecordingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([cameraId, startedAt])
  @@index([tenantId])
  @@index([status, retentionExpiresAt])
  @@map("recording_segments")
}

model RetentionPolicy {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  retentionDays  Int
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cameras Camera[]

  @@index([tenantId])
  @@map("retention_policies")
}

// ---------------------------------------------------------------------------
// Subscriptions / billing
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id               String   @id @default(uuid())
  key              String   @unique
  name             String
  cameraLimit      Int      @map("camera_limit")
  storageQuotaGb   Int      @map("storage_quota_gb")
  maxRetentionDays Int      @map("max_retention_days")
  priceCentsMonthly Int     @map("price_cents_monthly")
  isActive         Boolean  @default(true) @map("is_active")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique @map("tenant_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(TRIALING)
  billingProvider    String             @default("dev") @map("billing_provider")
  externalCustomerId String?            @map("external_customer_id")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model UsageRecord {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  periodStart      DateTime @map("period_start")
  periodEnd        DateTime @map("period_end")
  storageBytesUsed BigInt   @map("storage_bytes_used")
  cameraCount      Int      @map("camera_count")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, periodStart])
  @@map("usage_records")
}

// ---------------------------------------------------------------------------
// Notifications / audit / gateways / integrations
// ---------------------------------------------------------------------------

enum NotificationType {
  CAMERA_OFFLINE
  RECORDING_STOPPED
  STORAGE_QUOTA_WARNING
  UPLOAD_FAILURE
  RETENTION_CLEANUP_FAILURE
  MOTION_DETECTED
  PERSON_DETECTED
  VEHICLE_DETECTED
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  type      NotificationType
  /// What this notification is about (usually a camera id) — used to
  /// de-duplicate repeated alerts for the same ongoing condition (e.g. one
  /// camera staying offline for an hour of polling) instead of spamming a
  /// fresh row every poll. Nullable because not every notification type is
  /// tied to a single target (e.g. a tenant-wide storage warning).
  targetId  String?          @map("target_id")
  /// Linked MotionEvent (for snapshot thumbnails) on detection alerts.
  eventId   String?          @map("event_id")
  message   String
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, type, targetId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  actorUserId String? @map("actor_user_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

enum GatewayStatus {
  PENDING_ENROLLMENT
  ONLINE
  OFFLINE
  REVOKED
}

/// Placeholder for the Go local gateway agent (docs/architecture.md §6), not yet
/// implemented. Table exists now so the enrollment/heartbeat data model is
/// settled before that phase starts.
model GatewayDevice {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  name            String
  status          GatewayStatus @default(PENDING_ENROLLMENT)
  publicKey       String?       @map("public_key")
  lastHeartbeatAt DateTime?     @map("last_heartbeat_at")
  enrolledAt      DateTime?     @map("enrolled_at")
  revokedAt       DateTime?     @map("revoked_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("gateway_devices")
}

/// Outbound integrations. Implemented provider: "webhook" (signed JSON POST
/// for every new alert). Manufacturer-cloud connectors are future work.
model IntegrationConfig {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  provider  String
  name      String   @default("")
  /// Non-secret settings only (e.g. webhook URL, subscribed event types).
  config    Json
  /// AES-256-GCM encrypted secret (e.g. webhook signing secret), same scheme
  /// as CameraCredential. Never returned by the API after creation.
  encryptedSecret String? @map("encrypted_secret")
  secretIv        String? @map("secret_iv")
  isEnabled Boolean  @default(false) @map("is_enabled")
  lastDeliveryAt     DateTime? @map("last_delivery_at")
  lastDeliveryStatus String?   @map("last_delivery_status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("integration_configs")
}

/// One detected motion burst on a camera (every detection is stored; the
/// alert/notification for it is rate-limited separately by notifyOnce).
model MotionEvent {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  cameraId  String   @map("camera_id")
  /// Highest ffmpeg scene-change score (0..1) seen in the sample window.
  score     Float
  /// Threshold that was in effect (derived from the camera's sensitivity).
  threshold Float
  /// Object detections on the snapshot frame: [{ label, score }]. Null when
  /// the detector was unavailable (plain motion alert).
  labels      Json?
  /// Object-storage key of the JPEG snapshot (snapshots/ prefix).
  snapshotKey String?  @map("snapshot_key")
  detectedAt DateTime @default(now()) @map("detected_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([tenantId, detectedAt])
  @@index([cameraId, detectedAt])
  @@map("motion_events")
}

/// Workspace invitation. Only a SHA-256 hash of the token is stored; the raw
/// token appears once, in the emailed/logged accept link.
model Invite {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  email       String
  role        Role
  tokenHash   String    @unique @map("token_hash")
  invitedById String?   @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([email])
  @@map("invites")
}

/// One browser/device subscribed to Web Push for a user. Keys are the
/// browser-generated public encryption keys (not secrets of ours).
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSuccessAt DateTime? @map("last_success_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Firebase Cloud Messaging registration token of one native app install.
/// Tied to the mobile session that registered it, so logging out (or
/// revoking that session) stops pushes to the device.
model FcmToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  sessionId  String?  @map("session_id")
  token      String   @unique
  platform   String
  deviceName String?  @map("device_name")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSuccessAt DateTime? @map("last_success_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}

/// Audit trail for platform-admin actions (not tied to one workspace).
model PlatformAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("platform_audit_logs")
}
