{
  "name": "universal-cctv-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @cctv/api dev",
    "dev:web": "pnpm --filter @cctv/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "prisma:generate": "pnpm --filter @cctv/api prisma:generate",
    "prisma:migrate": "pnpm --filter @cctv/api prisma:migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss-selector-parser": "^7.1.6",
      "next>postcss": "^8.5.31"
    }
  }
}
